{
    "mcpServers": {
        "gsc": {
            "command": "npx",
            "args": [
                "-y",
                "suganthan-gsc-mcp"
            ],
            "env": {
                "GSC_AUTH_MODE": "oauth",
                "GSC_OAUTH_SECRETS_FILE": "./gsc-oath-secrets.json",
                "GSC_SITE_URL": "sc-domain:switch-to.eu"
            }
        },
        "reddit": {
            "command": "npx",
            "args": [
                "reddit-mcp-server"
            ]
        },
        "reddit-mcp-buddy": {
            "command": "sh",
            "args": [
                "-c",
                "if [ -f ./.env ]; then . ./.env; fi; export REDDIT_CLIENT_ID REDDIT_CLIENT_SECRET REDDIT_USERNAME REDDIT_PASSWORD; exec npx -y reddit-mcp-buddy@1.1.14"
            ]
        },
        "exa": {
            "type": "http",
            "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"
        }
    }
}
